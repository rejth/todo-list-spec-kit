{
  "name": "todo-list-spec-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check . && oxlint",
    "format": "biome format --write .",
    "check": "tsc --noEmit && biome check . && oxlint && vitest run --passWithNoTests",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "solid-js": "^1.9.3",
    "tiny-idb-store": "^0.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "lefthook": "^1.10.0",
    "oxlint": "^1.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.0.0"
  }
}
